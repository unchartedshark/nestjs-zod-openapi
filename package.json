{
  "name": "nestjs-zod-openapi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run build && node dist/src/main.js",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/main.js",
    "typecheck": "tsc --project tsconfig.typecheck.json --noEmit",
    "openapi:export": "npm run build && node dist/scripts/export-openapi.js",
    "generate:client": "orval --config orval.config.ts",
    "generate": "npm run openapi:export && npm run generate:client",
    "test": "vitest run",
    "verify": "npm run generate && npm run lint && npm run typecheck && npm run test && npm run build",
    "lint": "oxlint --deny-warnings src scripts test orval.config.ts vitest.config.ts",
    "auth:migrate": "tsx scripts/migrate-auth.ts"
  },
  "dependencies": {
    "@apollo/server": "^5.0.0",
    "@as-integrations/express5": "^1.1.2",
    "@nestjs/apollo": "^14.2.1",
    "@nestjs/common": "^12.0.2",
    "@nestjs/core": "^12.0.2",
    "@nestjs/graphql": "^14.2.1",
    "@nestjs/platform-express": "^12.0.2",
    "@nestjs/swagger": "^12.0.2",
    "@scalar/nestjs-api-reference": "^1.2.36",
    "graphql": "^16.11.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.2.0",
    "better-auth": "^1.7.27",
    "@thallesp/nestjs-better-auth": "^2.8.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.3",
    "@nestjs/testing": "^12.0.2",
    "orval": "^8.24.0",
    "supertest": "^7.1.0",
    "tsx": "^4.20.0",
    "typescript": "^6.0.0",
    "vitest": "^4.0.0",
    "@swc/core": "^1.13.0",
    "unplugin-swc": "^1.5.1",
    "oxlint": "^1.94.0"
  }
}
